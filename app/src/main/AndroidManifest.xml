<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase Authentication and Cloud Firestore need the internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pickup reminders: show notifications (Android 13+ asks the user) and restore them after a restart -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- QR scanning; the app still installs on devices without a camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLibraryApp"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: librarians import the catalogue from the demo web system on plain http:// (local Wi-Fi).
             A production server would use https:// and this could be removed. -->

        <!-- Sign in (opens when the app icon is tapped) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Screen 1: Catalogue (after sign-in) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Screen 2: Book details -->
        <activity
            android:name=".BookDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Screen 3: Reserve form -->
        <activity
            android:name=".ReserveActivity"
            android:exported="false"
            android:parentActivityName=".BookDetailActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Screen 4: My reservations -->
        <activity
            android:name=".MyReservationsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Administrators: approve accounts and assign roles -->
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateHidden" />

        <!-- Librarians: circulation desk -->
        <activity
            android:name=".DeskActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- QR scanner screen from the ZXing library: allow portrait as well as landscape -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- Shows pickup reminders when this app's alarm goes off -->
        <receiver
            android:name=".notify.PickupReminderReceiver"
            android:exported="false" />

        <!-- Restores pickup reminders after the phone restarts (only the system sends BOOT_COMPLETED) -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
