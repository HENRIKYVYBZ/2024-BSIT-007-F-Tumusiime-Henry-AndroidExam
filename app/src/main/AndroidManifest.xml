<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase Authentication needs the internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLibraryApp">

        <!-- Sign in (opens when the app icon is tapped) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Screen 1: Catalogue (after sign-in) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Screen 2: Book details -->
        <activity
            android:name=".BookDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Screen 3: Reserve form -->
        <activity
            android:name=".ReserveActivity"
            android:exported="false"
            android:parentActivityName=".BookDetailActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Screen 4: My reservations -->
        <activity
            android:name=".MyReservationsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
