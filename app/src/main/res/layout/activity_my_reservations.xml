<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 4: My reservations -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LibScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp">

        <TextView
            android:id="@+id/btn_back"
            style="@style/LibBackButton" />

        <TextView
            style="@style/LibHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/my_reservations_title" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/lib_bg">

        <ListView
            android:id="@+id/reservation_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:padding="16dp" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/empty_reservations"
            android:textColor="@color/lib_muted"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
