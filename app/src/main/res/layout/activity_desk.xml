<?xml version="1.0" encoding="utf-8"?>
<!-- Librarians: the circulation desk -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LibScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btn_back"
            style="@style/LibBackButton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/LibHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/circulation_desk" />

            <TextView
                android:id="@+id/desk_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lib_on_navy_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_catalogue"
            style="@style/LibHeaderPill"
            android:text="@string/catalogue" />

        <ImageView
            android:id="@+id/btn_scan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_search"
            android:clickable="true"
            android:contentDescription="@string/scan_qr"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_qr_scan" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/lib_bg"
        android:orientation="vertical">

        <!-- Shown until a librarian publishes the shared catalogue -->
        <LinearLayout
            android:id="@+id/catalogue_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/bg_notice_box"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/catalogue_empty_message"
                android:textColor="@color/lib_notice"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_publish_samples"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="@string/publish_samples_short"
                    android:textAllCaps="false"
                    android:textColor="@color/lib_navy"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_import"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:stateListAnimator="@null"
                    android:text="@string/import_short"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="14dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/tab_pickups"
                style="@style/LibTab"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_loans"
                style="@style/LibTab"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_overdue"
                style="@style/LibTab"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_stock"
                style="@style/LibTab"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- After scanning a book: only that book's holds and loans are shown -->
        <TextView
            android:id="@+id/filter_chip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/desk_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:padding="16dp" />

            <TextView
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/loading"
                android:textColor="@color/lib_muted"
                android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
