<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LibScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp">

        <TextView
            android:id="@+id/btn_back"
            style="@style/LibBackButton" />

        <TextView
            style="@style/LibHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/reset_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/lib_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_heading"
                android:textColor="@color/lib_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/reset_intro"
                android:textColor="@color/lib_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/error_text"
                style="@style/LibErrorBox" />

            <TextView
                android:id="@+id/success_text"
                style="@style/LibErrorBox"
                android:background="@drawable/bg_success_box"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/lib_green" />

            <TextView
                style="@style/LibLabel"
                android:text="@string/label_email" />

            <EditText
                android:id="@+id/input_email"
                style="@style/LibInput"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress" />

            <Button
                android:id="@+id/btn_send"
                style="@style/LibPrimaryButton"
                android:layout_marginTop="24dp"
                android:text="@string/send_reset_link" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
