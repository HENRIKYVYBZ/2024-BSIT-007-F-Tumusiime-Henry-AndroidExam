<?xml version="1.0" encoding="utf-8"?>
<!-- Librarians: add a new book or edit one -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LibScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp">

        <TextView
            android:id="@+id/btn_back"
            style="@style/LibBackButton" />

        <TextView
            android:id="@+id/edit_title"
            style="@style/LibHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/add_book_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/lib_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/error_text"
                style="@style/LibErrorBox" />

            <TextView
                style="@style/LibLabel"
                android:text="@string/label_book_title" />

            <EditText
                android:id="@+id/input_title"
                style="@style/LibInput"
                android:hint="@string/hint_book_title"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLength="150" />

            <TextView
                style="@style/LibLabel"
                android:text="@string/label_author" />

            <EditText
                android:id="@+id/input_author"
                style="@style/LibInput"
                android:hint="@string/hint_author"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="120" />

            <TextView
                style="@style/LibLabel"
                android:text="@string/label_category" />

            <EditText
                android:id="@+id/input_category"
                style="@style/LibInput"
                android:hint="@string/hint_category"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLength="60" />

            <TextView
                style="@style/LibLabel"
                android:text="@string/label_shelf" />

            <EditText
                android:id="@+id/input_shelf"
                style="@style/LibInput"
                android:hint="@string/hint_shelf"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLength="40" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LibLabel"
                        android:text="@string/label_year" />

                    <EditText
                        android:id="@+id/input_year"
                        style="@style/LibInput"
                        android:hint="@string/hint_year"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="4" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LibLabel"
                        android:text="@string/label_copies" />

                    <EditText
                        android:id="@+id/input_copies"
                        style="@style/LibInput"
                        android:hint="@string/hint_copies"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="3" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/copies_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/lib_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                style="@style/LibLabel"
                android:text="@string/label_about" />

            <EditText
                android:id="@+id/input_description"
                style="@style/LibInput"
                android:gravity="top"
                android:hint="@string/hint_description"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="1000"
                android:minLines="3"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btn_save"
                style="@style/LibPrimaryButton"
                android:layout_marginTop="26dp"
                android:text="@string/save_book" />

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline_red"
                android:stateListAnimator="@null"
                android:text="@string/delete_book"
                android:textAllCaps="false"
                android:textColor="@color/lib_red"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
