<?xml version="1.0" encoding="utf-8"?>
<!-- Opened by the link in a password-reset email: choose a new password and confirm it.
     The same screen also finishes "verify your email" links. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LibScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp">

        <TextView
            android:id="@+id/btn_back"
            style="@style/LibBackButton" />

        <TextView
            android:id="@+id/screen_title"
            style="@style/LibHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/new_password_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/lib_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- While the link is being checked -->
            <LinearLayout
                android:id="@+id/panel_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="60dp">

                <ProgressBar
                    android:layout_width="44dp"
                    android:layout_height="44dp" />

                <TextView
                    android:id="@+id/loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/checking_link"
                    android:textColor="@color/lib_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- New password + confirm -->
            <LinearLayout
                android:id="@+id/panel_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/new_password_heading"
                    android:textColor="@color/lib_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/new_password_for"
                    android:textColor="@color/lib_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/account_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_email_chip"
                    android:paddingBottom="7dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:textColor="@color/lib_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/error_text"
                    style="@style/LibErrorBox" />

                <TextView
                    style="@style/LibLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_new_password" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/input_password"
                        style="@style/LibInput"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_new_password"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:paddingRight="72dp" />

                    <TextView
                        android:id="@+id/toggle_password"
                        style="@style/LibPasswordToggle" />
                </FrameLayout>

                <!-- Strength meter: four bars and a word -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/meter_1"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_meter_segment" />

                    <View
                        android:id="@+id/meter_2"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_meter_segment" />

                    <View
                        android:id="@+id/meter_3"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_meter_segment" />

                    <View
                        android:id="@+id/meter_4"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_meter_segment" />

                    <TextView
                        android:id="@+id/meter_label"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:gravity="end"
                        android:textColor="@color/lib_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/LibLabel"
                    android:text="@string/label_confirm_new_password" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/input_confirm"
                        style="@style/LibInput"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_confirm_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:paddingRight="72dp" />

                    <TextView
                        android:id="@+id/toggle_confirm"
                        style="@style/LibPasswordToggle" />
                </FrameLayout>

                <!-- Live checklist: each line turns green when the rule is met -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rules_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/rule_length"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/rule_letter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/rule_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/rule_match"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save"
                    style="@style/LibPrimaryButton"
                    android:layout_marginTop="24dp"
                    android:text="@string/save_new_password" />
            </LinearLayout>

            <!-- Finished, or the link could not be used -->
            <LinearLayout
                android:id="@+id/panel_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/result_icon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_step_done"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="@color/lib_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/lib_muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_result"
                    style="@style/LibPrimaryButton"
                    android:layout_marginTop="28dp" />

                <TextView
                    android:id="@+id/link_result_secondary"
                    style="@style/LibLink"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
