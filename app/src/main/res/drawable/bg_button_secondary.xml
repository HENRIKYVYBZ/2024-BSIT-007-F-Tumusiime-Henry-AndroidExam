<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined navy button, e.g. "No-show" -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/lib_grey_bg" /><corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/lib_navy" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#FFFFFF" /><corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/lib_navy" /></shape>
    </item>
</selector>
